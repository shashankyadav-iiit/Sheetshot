# Polar — required to take real $9 payments.
# Leave blank for local UI work; /checkout will explain instead of crashing.

POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
SUCCESS_URL=http://localhost:3000/success?checkout_id={CHECKOUT_ID}
POLAR_SERVER=sandbox

# Auth.js / NextAuth — Google sign-in. Leave blank to keep the app running;
# Sign in explains instead of crashing.

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=https://sheetshot-five.vercel.app
